<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
            <size
                android:width="64dp"
                android:height="64dp" />
        </shape>
    </item>
    <!-- 白色边框 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="62dp"
                android:height="62dp" />
        </shape>
    </item>
    <!-- 绿色背景 -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#2dba98" />
            <size
                android:width="58dp"
                android:height="58dp" />
        </shape>
    </item>
</layer-list>
