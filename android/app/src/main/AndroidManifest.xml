<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════ 网络 ═══════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ═══════════════════ 位置（地图/导航/打卡） ═══════════════════ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ═══════════════════ 录音（数字人/直播/唤醒/实时讲解） ═══════════════════ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ═══════════════════ 相机（打卡/发布帖/实时讲解） ═══════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ═══════════════════ 存储（相册选图/上传） ═══════════════════ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- ═══════════════════ 震动反馈 ═══════════════════ -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ═══════════════════ 前台服务（global-dh 后台唤醒监听） ═══════════════════ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ═══════════════════ 拨号 ═══════════════════ -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- ═══════════════════ 安装外部应用（可选） ═══════════════════ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ═══════════════════ 浮窗（Phase 2 global-dh） ═══════════════════ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".SuiXingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuiXing"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ═══════════════════ Activity ═══════════════════ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale|locale|layoutDirection|density"
            android:theme="@style/Theme.SuiXing.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ═══════════════════ 高德地图 SDK Key ═══════════════════ -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_ANDROID_KEY}" />

        <!-- 定位 SDK 要求声明 service -->
        <service android:name="com.amap.api.location.APSService" />

        <!-- AMap 隐私合规声明 -->
        <meta-data
            android:name="com.amap.api.v2.map.privacy"
            android:value="true" />
        <meta-data
            android:name="com.amap.api.v2.loc.privacy"
            android:value="true" />
        <meta-data
            android:name="com.amap.api.v2.search.privacy"
            android:value="true" />

        <!-- ═══════════════════ ForegroundService（唤醒监听预留） ═══════════════════ -->
        <service
            android:name=".core.service.WakeUpService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ═══════════════════ FileProvider（图片分享/上传） ═══════════════════ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
