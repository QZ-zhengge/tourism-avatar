# =============================================================================
# 环境配置模板
# 使用方式：复制此文件为 .env，填入你的实际配置后启动服务
#   cp .env.example .env
# =============================================================================

# ── 数据库配置 ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=hbuilder_app

# ── 服务器配置 ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── 日志配置 ───────────────────────────────────────────
LOG_LEVEL=DEBUG

# ── 讯飞虚拟人配置 ─────────────────────────────────────
# 请到 https://console.xfyun.cn 创建应用获取以下凭证
XFYUN_APP_ID=CHANGE_ME
XFYUN_API_KEY=CHANGE_ME
XFYUN_API_SECRET=CHANGE_ME

# ── 讯飞虚拟人服务地址（一般不需要改动）────────────────
XFYUN_VMS_HOST=vms.cn-huadong-1.xf-yun.com
XFYUN_VMS_BASE_URL=https://vms.cn-huadong-1.xf-yun.com
XFYUN_VMS_WSS_URL=wss://vms.cn-huadong-1.xf-yun.com

# ── 默认虚拟人配置 ─────────────────────────────────────
XFYUN_DEFAULT_AVATAR_ID=118801001
XFYUN_DEFAULT_VCN=x4_lingxiaoyu_assist

# ── 高德地图 API 配置 ───────────────────────────────────
# 请到 https://console.amap.com/dev/key 创建「Web服务」类型应用后获取
AMAP_API_KEY=CHANGE_ME
